# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml and fill in your actual private credentials.
# NOTE: .streamlit/secrets.toml is listed in .gitignore and will NEVER be committed to git.

# Secret Officer Passcode used to unlock live team data and editing mode in the dashboard
OFFICER_PASSWORD = "replace_with_your_secure_officer_passcode"

# Private Google Form / Sheets Response URL or Spreadsheet ID for Member Syncing
MEMBERSHIP_FORM_SHEET_URL = "https://docs.google.com/spreadsheets/d/YOUR_REAL_SPREADSHEET_ID/edit#gid=0"
